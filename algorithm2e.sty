% Minimal algorithm2e.sty - provides algorithm2e-compatible pseudocode environment
% Supports: algorithm float, ruled style, line numbering, standard keywords
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{algorithm2e}[2026/05/15 Minimal algorithm2e for ProvGuard-RAG]

\RequirePackage{ifthen}
\RequirePackage{xkeyval}
\RequirePackage{float}

% ---- Options ----
\newboolean{alg@ruled}\setboolean{alg@ruled}{true}
\newboolean{alg@linesnumbered}\setboolean{alg@linesnumbered}{true}

\DeclareOptionX{ruled}{\setboolean{alg@ruled}{true}}
\DeclareOptionX{linesnumbered}{\setboolean{alg@linesnumbered}{true}}
\DeclareOptionX{noline}{\setboolean{alg@linesnumbered}{false}}
\DeclareOptionX*{\PassOptionsToPackage{\CurrentOption}{float}}
\ProcessOptionsX

% ---- Define the algocf float via float.sty ----
\newfloat{algocf}{htbp}{loa}
\floatname{algocf}{Algorithm}

% ---- Counter ----
\newcounter{AlgoLine}

% ---- Lengths ----
\newlength{\algomargin}
\setlength{\algomargin}{1.5em}

% ---- Internal helpers ----
\newcommand{\algoline}[1]{%
  \ifthenelse{\boolean{alg@linesnumbered}}%
    {\stepcounter{AlgoLine}\makebox[\algomargin][r]{\footnotesize\theAlgoLine\hspace*{0.5em}}}%
    {\makebox[\algomargin][r]{}}%
  #1%
}
\newcommand{\algokeywordfont}{\bfseries}

% ---- Newline macro ----
\newcommand{\algonewline}{\hfill\break\algoline{}}

% ---- \; inside algorithm (defined locally) ----
\newcommand{\alg@semi}{;}
\newcommand{\@alg@activate}{%
  \let\alg@orig@semi\;%
  \def\;{\alg@semi\algonewline}%
}
\newcommand{\@alg@deactivate}{%
  \let\;\alg@orig@semi%
}

% ---- Keywords (use \; which is active only inside algorithm) ----
\newcommand{\KwIn}[1]{\algokeywordfont{Input:} #1\algonewline}
\newcommand{\KwOut}[1]{\algokeywordfont{Output:} #1\algonewline}

% ---- \tcp comment ----
\newcommand{\tcp}[1]{\hspace*{1em}{\normalfont//} #1}

% ---- \Return ----
\newcommand{\Return}[1]{\algokeywordfont{return} #1\;}

% ---- Control structure indentation block ----
\newenvironment{alg@block}[1]{%
  \algoline{#1\strut}\begin{list}{}{%
    \setlength{\topsep}{0pt}\setlength{\partopsep}{0pt}%
    \setlength{\parsep}{0pt}\setlength{\itemsep}{0pt}%
    \setlength{\leftmargin}{2em}\setlength{\rightmargin}{0pt}%
    \setlength{\labelwidth}{0pt}\setlength{\labelsep}{0pt}}%
  \item}{\end{list}}

\newcommand{\For}[2]{%
  \algoline{\algokeywordfont{for} #1 \algokeywordfont{do}}\begin{alg@block}{}#2\end{alg@block}}
\newcommand{\ForEach}[2]{%
  \algoline{\algokeywordfont{for each} #1 \algokeywordfont{do}}\begin{alg@block}{}#2\end{alg@block}}
\newcommand{\If}[2]{%
  \algoline{\algokeywordfont{if} #1 \algokeywordfont{then}}\begin{alg@block}{}#2\end{alg@block}}
\newcommand{\eIf}[3]{%
  \algoline{\algokeywordfont{if} #1 \algokeywordfont{then}}\begin{alg@block}{}#2\end{alg@block}%
  \algoline{\algokeywordfont{else}}\begin{alg@block}{}#3\end{alg@block}}
\newcommand{\While}[2]{%
  \algoline{\algokeywordfont{while} #1 \algokeywordfont{do}}\begin{alg@block}{}#2\end{alg@block}}

% ---- Algorithm float environment ----
\newenvironment{algorithm}[1][]{%
  \@alg@activate
  \setcounter{AlgoLine}{0}%
  \algocf[#1]%
  \ifthenelse{\boolean{alg@ruled}}{%
    \hrule height0.4pt\relax\vspace{-1pt}%
  }{}%
  \noindent\algofont\ignorespaces%
}{%
  \ifthenelse{\boolean{alg@ruled}}{%
    \vspace{-2pt}\hrule height0.4pt\relax%
  }{}%
  \@alg@deactivate
  \endalgocf%
}

\newcommand{\algofont}{\small}

% ---- Compatibility stubs for hyperref ----
\providecommand{\algocf@nl@sethref}[1]{}
\makeatletter
\let\algocf@nl@sethref\@gobble
\makeatother

% ---- Compatibility stubs ----
\newcommand{\LinesNumbered}{\setboolean{alg@linesnumbered}{true}}
\newcommand{\LinesNotNumbered}{\setboolean{alg@linesnumbered}{false}}
\newcommand{\SetAlgoLined}{}
\newcommand{\SetAlgoNoLine}{}
\newcommand{\BlankLine}{\algonewline}
\newcommand{\DontPrintSemicolon}{}
\newcommand{\SetKwFunction}[2]{\newcommand{#1}{\algokeywordfont{#2}}}
\newcommand{\SetKwProg}[3]{\newcommand{#1}[1]{\algoline{\algokeywordfont{#2} ##1 #3}}}
\newcommand{\SetKwBlock}[3]{}
\newcommand{\SetKwIF}[4]{}
\newcommand{\SetKwFor}[4]{}

% ---- Algorithm label/ref ----
\renewcommand{\thealgocf}{\arabic{algocf}}

\endinput
